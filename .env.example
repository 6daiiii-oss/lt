NODE_ENV=development
# compose enables automatic local PostgreSQL startup in npm run dev.
LOTE_LOCAL_DATABASE=compose
PORT=3000
APP_ORIGIN=http://localhost:3000
# npm run setup:local generates these three local values securely.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
SANDBOX_WEBHOOK_SECRET=
PAYMENT_PROVIDER=sandbox
SMS_PROVIDER=sandbox
# For real SMS: SMS_PROVIDER=twilio. Configure a Verify service with 6 digits.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
RESERVATION_MINUTES=15
STOCK_MAX_AGE_HOURS=48
NEW_PRODUCTS_DAYS=30
IMPORT_MAX_ROWS=1000
IMPORT_MAX_BYTES=1048576
UPLOAD_MAX_BYTES=5242880
STORAGE_DIR=.runtime/uploads
FEED_ALLOWED_ORIGINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production additionally requires BUSINESS_CONTACT_EMAIL and reviewed policies.
BUSINESS_CONTACT_EMAIL=
POLICIES_APPROVED=false
